# Copy to backend/.env and fill in real values. Never commit .env.

# Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<long-random-string>
CLIENT_URL=http://localhost:5173

# Email: set ONE provider. Brevo is used when BREVO_API_KEY is set.
# Brevo (free, no domain needed): MAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=<brevo-api-key>
# Resend (only delivers to your own address until you verify a domain)
RESEND_API_KEY=
MAIL_FROM=PREP <you@gmail.com>
# Optional: where recipe requests are emailed (defaults to the MAIL_FROM address)
ADMIN_EMAIL=

# Optional
PORT=5000
# Extra frontend origins allowed by CORS, comma-separated (e.g. Vercel previews)
CORS_ORIGINS=
